# Copy this file to keystore.properties and fill in your values.
# keystore.properties is gitignored — never commit passwords or the .jks file.
#
# Generate the keystore once (from the project root):
#   keytool -genkey -v -keystore sqliteadmin-release.jks -keyalg RSA -keysize 2048 -validity 10000 -alias sqliteadmin
#
# storeFile is relative to the project root (where this file lives).

storeFile=sqliteadmin-release.jks
storePassword=REPLACE_ME
keyAlias=sqliteadmin
keyPassword=REPLACE_ME
